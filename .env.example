# JANET Virtual Airline Ecosystem
# Copy to .env.local for development and replace placeholders locally.
# Never commit real credentials. NEXT_PUBLIC_* values are browser-visible.

# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase browser/user-scoped access
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase privileged server access (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijoia2F0ZW94byIsImEiOiJjbW5ja2thcHgxNjJmMnBvaG5wZHUyc3ptIn0.dpir2nZpJwxkUw4GK_qvHQ

# Central JVA voice server. Set these as Cloudflare Worker variables/secrets;
# never expose the API secret in a NEXT_PUBLIC_ variable.
JVA_VOICE_URL="wss://voice.example.com"
JVA_VOICE_API_KEY="JVA_voice_2026"
JVA_VOICE_API_SECRET="your-long-random-voice-secret"
