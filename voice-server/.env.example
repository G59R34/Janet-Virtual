# Copy to .env on the Linux voice laptop. Never commit the real .env file.
# Generate the secret with: openssl rand -base64 48
LIVEKIT_API_KEY=JVA_voice_2026
LIVEKIT_API_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public hostname only. Do not include ws:// or wss:// here.
# For a LAN-only trial you may use the laptop's LAN IP.
JVA_VOICE_HOST=voice.example.com
JVA_VOICE_TLS_EMAIL=admin@example.com

# true when the laptop is reached through a public/NAT address.
LIVEKIT_USE_EXTERNAL_IP=true
